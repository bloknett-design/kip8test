{
  "name": "kipia-desktop",
  "version": "1.0.6",
  "description": "КИПиА — справочник инженера (десктопное приложение)",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:mac": "electron-builder --mac",
    "build": "electron-builder --win --linux"
  },
  "author": {
    "name": "bloknett-design",
    "email": "bloknett.design@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "build": {
    "appId": "com.bloknett.kipia",
    "productName": "КИПиА",
    "copyright": "Copyright © 2025 bloknett-design",
    "publish": {
      "provider": "github",
      "owner": "bloknett-design",
      "repo": "kip8test"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "sw.js",
      "manifest.json",
      "images/**/*",
      "data/**/*",
      "electron/**/*"
    ],
    "extraResources": [],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "images/icon-512.png",
      "artifactName": "KIPiA-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "ru"
      ],
      "language": 1049,
      "shortcutName": "КИПиА",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "images/icon-512.png",
      "category": "Utility",
      "artifactName": "KIPiA-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "images/icon-512.png",
      "artifactName": "KIPiA-${version}.${ext}"
    }
  }
}
